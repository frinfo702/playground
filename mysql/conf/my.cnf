# Shared by the container and the local server (bin/local).
[mysqld]
character-set-server = utf8mb4
innodb_buffer_pool_size = 256M
# Log every query slower than 0.5s (file lives in the datadir).
slow_query_log = ON
long_query_time = 0.5
# Write every deadlock to the error log, not just the last one.
innodb_print_all_deadlocks = ON
